{
  "name": "reem-ios",
  "version": "1.0.0",
  "private": true,
  "description": "ريم السكرتيرة — تطبيق آيفون (Capacitor)",
  "scripts": {
    "build": "rm -rf www && mkdir -p www && cp ../index.html ../icon.svg ../manifest.json ../reem.jpg ../icon-*.png www/",
    "assets": "capacitor-assets generate --ios --iconBackgroundColor '#0e4d5c' --splashBackgroundColor '#0e4d5c' --splashBackgroundColorDark '#0a3540'"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
